Subject: [PATCH] Custom block mining


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 7eed64d806e7a2848db122527d14594ec669e5cc..d302490d178fe864be61025443674915e4957e1f 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2648,6 +2648,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     }
 
     public void injectScaledMaxHealth(Collection<AttributeInstance> collection, boolean force) {
+        this.getHandle().gameMode.customBlockMining.injectClientAttribute(collection); // Citrus - custom block mining
         if (!this.scaledHealth && !force) {
             return;
         }
