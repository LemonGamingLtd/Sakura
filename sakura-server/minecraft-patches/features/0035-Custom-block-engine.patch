diff --git a/net/minecraft/nbt/NbtUtils.java b/net/minecraft/nbt/NbtUtils.java
index 61394351fa87314507a040f3db3f3d504245c3d9..ef2b200c01fa4fd64973ec51a8a5f7b8071c37a1 100644
--- a/net/minecraft/nbt/NbtUtils.java
+++ b/net/minecraft/nbt/NbtUtils.java
@@ -124,6 +124,14 @@ public final class NbtUtils {
     public static BlockState readBlockState(final HolderGetter<Block> blocks, final CompoundTag tag) {
         Optional<? extends Holder<Block>> blockHolder = tag.read("id", BLOCK_NAME_CODEC).flatMap(blocks::get);
         if (blockHolder.isEmpty()) {
+            // Citrus start - custom blocks
+            final Block fallback = tag.read("id", BLOCK_NAME_CODEC)
+                .map(key -> ltd.lemongaming.citrus.block.CustomBlockPersistence.fallbackFor(key.identifier()))
+                .orElse(null);
+            if (fallback != null) {
+                return fallback.defaultBlockState();
+            }
+            // Citrus end - custom blocks
             return Blocks.AIR.defaultBlockState();
         }
 
diff --git a/net/minecraft/network/codec/ByteBufCodecs.java b/net/minecraft/network/codec/ByteBufCodecs.java
